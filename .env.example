# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- Authentication (Task 3) --------------------------------------------------
# JWT signing key for API authentication (min 32 characters for HMAC-SHA256).
# Token lifetime chosen: 8 hours (covers a standard support agent work shift).
Authentication__Jwt__SecretKey=LocalDev_Jwt_Secret_Key_Change_In_Production_32chars!
Authentication__Jwt__Issuer=NorthwindSupportDesk
Authentication__Jwt__Audience=NorthwindSupportDesk
Authentication__Jwt__ExpiryHours=8

# --- Docker (Task 4) ---------------------------------------------------------
# Used by docker-compose.yml to pass JWT config to the container at runtime.
# Override in .env (never commit real values).
JWT_SECRET_KEY=LocalDev_Jwt_Secret_Key_Change_In_Production_32chars!
JWT_ISSUER=NorthwindSupportDesk
JWT_AUDIENCE=NorthwindSupportDesk
JWT_EXPIRY_HOURS=8

# DK-8: To run the React dev server against the dockerised API instead of the
# locally-running dotnet process, set this variable:
#   VITE_API_PROXY_TARGET=http://localhost:5080 npm run web
# The Vite proxy at /api will forward to the container on port 5080.
VITE_API_PROXY_TARGET=http://localhost:5080

